<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F5F8F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- BACK BUTTON -->

        <Button
            android:id="@+id/btnStepsBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←  Steps"
            android:textColor="#145A24"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@android:color/transparent"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="8dp" />

        <!-- TITLE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Daily Steps"
            android:textColor="#145A24"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Keep moving throughout the day"
            android:textColor="#555555"
            android:textSize="15sp"
            android:gravity="center" />

        <!-- ICON -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:text="🚶"
            android:textSize="65sp"
            android:gravity="center" />

        <!-- CURRENT STEPS -->

        <TextView
            android:id="@+id/txtStepsAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="0"
            android:textColor="#145A24"
            android:textSize="38sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Steps completed today"
            android:textColor="#777777"
            android:textSize="15sp"
            android:gravity="center" />

        <!-- INPUT -->

        <EditText
            android:id="@+id/edtSteps"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="30dp"
            android:hint="Enter your steps"
            android:inputType="number"
            android:padding="15dp"
            android:textSize="16sp"
            android:backgroundTint="#1B5E20" />

        <!-- SAVE BUTTON -->

        <Button
            android:id="@+id/btnSaveSteps"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="15dp"
            android:text="Save Steps"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:backgroundTint="#1B5E20" />

        <!-- INFO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💡 Steps Tip"
                android:textColor="#145A24"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Try to stay active throughout the day. Walking, taking the stairs, and short movement breaks can all contribute to your daily steps."
                android:textColor="#555555"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
