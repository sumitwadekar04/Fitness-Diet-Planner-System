<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F8F5"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- BACK BUTTON -->

        <Button
            android:id="@+id/btnWaterBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←  Water Intake"
            android:textColor="#145A24"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:backgroundTint="#FFFFFF"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="8dp" />
        <!-- TITLE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Water Intake"
            android:textColor="#145A24"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Keep yourself hydrated throughout the day"
            android:textColor="#555555"
            android:textSize="15sp"
            android:gravity="center" />

        <!-- WATER ICON -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:text="💧"
            android:textSize="65sp"
            android:gravity="center" />

        <!-- CURRENT AMOUNT -->

        <TextView
            android:id="@+id/txtWaterAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="0 ml"
            android:textColor="#145A24"
            android:textSize="38sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Water consumed today"
            android:textColor="#777777"
            android:textSize="15sp"
            android:gravity="center" />

        <!-- BUTTONS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRemoveWater"
                android:layout_width="60dp"
                android:layout_height="55dp"
                android:text="−"
                android:textSize="25sp"
                android:textColor="#145A24"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnAddWater"
                android:layout_width="180dp"
                android:layout_height="55dp"
                android:layout_marginStart="15dp"
                android:text="+  Add Water"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:backgroundTint="#1B5E20" />

        </LinearLayout>

        <!-- INFO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💡 Hydration Tip"
                android:textColor="#145A24"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Drink water regularly throughout the day. Your hydration needs can vary depending on activity, weather, and other factors."
                android:textColor="#555555"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>

